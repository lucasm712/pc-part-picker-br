generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Socket {
  id           Int           @id @default(autoincrement())
  nome         String        @unique
  cpus         Cpu[]
  motherboards Motherboard[]
}

model Cpu {
  id                Int      @id @default(autoincrement())
  nome              String   @unique
  socketId          Int
  preco             Decimal?
  createdAt         DateTime @default(now())
  wtts              Int?
  graficoIntegrado Boolean? @map("grafico_integrado")
  socket            Socket   @relation(fields: [socketId], references: [id])
}

model Motherboard {
  id               Int      @id @default(autoincrement())
  nome             String   @unique 
  socketId         Int
  tipoRam          TipoRam
  formFactor       String?
  preco            Decimal?
  createdAt        DateTime @default(now())
  Maximo_de_ram    Int?     @map("Maximo_de_ram")
  slots_de_memoria Int?     @map("slots_de_memoria")
  socket           Socket   @relation(fields: [socketId], references: [id])
}

model Ram {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  preco     Decimal?
  createdAt DateTime @default(now())
  tipo      TipoRam 
  tamanho   Int 
  pentes    Int      @default(1) 
}

model Gpu {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  tdp       Int
  memoria   Int 
  preco     Decimal?
  createdAt DateTime @default(now())
}

enum TipoRam {
  DDR4
  DDR5
} 

model CpuCooler { 
  id      Int  @id @default(autoincrement())
  nome    String 
  preco   Decimal?
  createdAt DateTime @default(now())
} 

model Ssd {
   id      Int  @id @default(autoincrement()) 
   nome    String   @unique
   tamanho Int 
   tipoSsd TipoSsd
   preco   Decimal?
  createdAt DateTime @default(now())
} 
enum TipoSsd {
  NVME_M2
  SATA_M2
  SATA_2_5 
}

model Psu { 
   id      Int  @id @default(autoincrement()) 
   nome    String @unique
   wtts    Int 
   seloEficiencia SeloEficiencia
   preco   Decimal?
  createdAt DateTime @default(now())
} 

enum SeloEficiencia {
  SEM_SELO
  PLUS_80_WHITE
  PLUS_80_BRONZE
  PLUS_80_SILVER
  PLUS_80_GOLD
  PLUS_80_PLATINUM
  PLUS_80_TITANIUM
} 

model Case { 
 id      Int  @id @default(autoincrement()) 
nome String 
 preco   Decimal?
  createdAt DateTime @default(now())
} 
